# Offline tools and screenshot studio need no credentials.
# Android Publisher API optional: point to a service-account JSON file OUTSIDE the repository.
# Grant this account access to the intended app in Play Console, not unnecessary account-wide rights.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/play-service-account.json
# Optional alternative: Application Default Credentials from your approved Google Cloud setup.
# This template is documentation. The tools do NOT automatically source .env files.
# Google Ads optional: ADC with https://www.googleapis.com/auth/adwords scope,
# a developer token from your Ads manager account, and authorized customer access.
# See docs/google-ads-api.md. No token is required for offline planning.
GOOGLE_ADS_DEVELOPER_TOKEN=replace-outside-this-repository
# Optional manager customer ID without hyphens, when access is through that manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional AppStoreSpy Android API; --execute may consume provider credits.
# No key is loaded for offline plans. See docs/aso-data-api.md.
APPSTORESPY_API_KEY=replace-outside-this-repository
# Play GCS report reads use ADC with devstorage.read_only and bucket permissions.
# Bucket/object are explicit CLI arguments, not inferred from the application.
